# ==============================================================================
# ThoracicAI — CT Research & Classification Platform (Frontend Configuration)
# ==============================================================================
# Copy this file to '.env' or '.env.local' in this directory if required.
# Note: Vite injects variables starting with VITE_* into client bundle.
# NEVER expose backend service role keys, DB passwords, or JWT secrets here.
# ==============================================================================

# Backend API Base URL
# In local development: /api (proxied by Vite to http://127.0.0.1:8000)
# In production on Vercel: /api (routed via vercel.json rewrites or full backend URL)
VITE_API_BASE_URL=/api

# Supabase Client Configuration (Optional Fallbacks)
# The frontend automatically fetches public credentials from the backend via GET /api/auth/config.
# You may optionally define these for offline or decoupled static testing:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
