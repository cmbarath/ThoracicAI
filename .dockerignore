# ============================================================
# Root Dockerignore for ThoracicAI Repository
# ============================================================

# Security & Secrets (CRITICAL - NEVER BAKE INTO DOCKER IMAGE)
.env
.env.*
!.env.example
*.env
*.env.txt
secrets.json
*.pem
*.key

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Local database & storage
*.db
backend/storage/
storage/

# Node & Frontend (not needed in backend container)
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/

# Tests & test reports
tests/
frontend/e2e/
test-results/
playwright-report/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Version control & IDE artifacts
.git/
.gitignore
.DS_Store
Thumbs.db
.idea/
.vscode/
