# ==============================================================================
# ThoracicAI — CT Research & Classification Platform (Backend Configuration)
# ==============================================================================
# Copy this file to '.env' in this directory and populate with real credentials.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection URI (recommended: Supabase Session/Transaction Pooler on port 5432 or 6543)
# Example: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Alternatively, configure individual connection parameters if not using full URI:
SUPABASE_DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_NAME=postgres
Project_ID=your-project-ref

# ------------------------------------------------------------------------------
# 2. SUPABASE PROJECT & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Obtained from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-local-hmac-verification

# ------------------------------------------------------------------------------
# 3. ADMINISTRATIVE USER CONFIGURATION
# ------------------------------------------------------------------------------
# Email address designated as System Administrator. Any user registering or logging
# in with this email will automatically be assigned the 'ADMIN' role in public.profiles.
# You can also run: python -m app.cli.set_admin your-admin@institution.org
ADMIN_EMAIL=admin@thoracicai.org

# ------------------------------------------------------------------------------
# 4. REPORT STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# 'local' saves reports into backend/storage/reports/
# 'supabase' uploads reports into the private Supabase Storage bucket
STORAGE_BACKEND=local
SUPABASE_STORAGE_BUCKET=thoracicai-reports

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & SECURITY HEADERS
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=False
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://your-domain.vercel.app"]

# ------------------------------------------------------------------------------
# 6. INFERENCE & UPLOAD LIMITS
# ------------------------------------------------------------------------------
INFERENCE_BATCH_SIZE=16
MAX_FILE_BYTES=52428800
MAX_TOTAL_BYTES=524288000
MAX_IMAGE_COUNT=120
